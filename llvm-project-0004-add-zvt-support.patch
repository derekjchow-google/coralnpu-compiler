+static bool isZvtMatMul(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTFMM_F32_TVV:
+  case RISCV::PseudoVTFMM_F16_TVV:
+  case RISCV::PseudoVTFMM_ALT_TVV:
+  case RISCV::PseudoVTMMU_TVV:
+  case RISCV::PseudoVTMMS_TVV:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static unsigned getZvtSEW(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTFMM_F32_TVV:
+    return 32;
+  case RISCV::PseudoVTFMM_F16_TVV:
+  case RISCV::PseudoVTFMM_ALT_TVV:
+    return 16;
+  case RISCV::PseudoVTMMU_TVV:
+  case RISCV::PseudoVTMMS_TVV:
+    return 8;
+  default:
+    llvm_unreachable("Unexpected Zvt opcode");
+  }
+}
+
+static bool isZvtMemOp(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTLE8:
+  case RISCV::PseudoVTSE8:
+  case RISCV::PseudoVTLE16:
+  case RISCV::PseudoVTSE16:
+  case RISCV::PseudoVTLE32:
+  case RISCV::PseudoVTSE32:
+  case RISCV::PseudoVTLE64:
+  case RISCV::PseudoVTSE64:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static unsigned getZvtMemOpSEW(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTLE8:
+  case RISCV::PseudoVTSE8:
+    return 8;
+  case RISCV::PseudoVTLE16:
+  case RISCV::PseudoVTSE16:
+    return 16;
+  case RISCV::PseudoVTLE32:
+  case RISCV::PseudoVTSE32:
+    return 32;
+  case RISCV::PseudoVTLE64:
+  case RISCV::PseudoVTSE64:
+    return 64;
+  default:
+    llvm_unreachable("Unexpected Zvt mem opcode");
+  }
+}
