+    case Intrinsic::riscv_zvt_vtmms_tvv:
+    case Intrinsic::riscv_zvt_vtfmm_tvv:
+    case Intrinsic::riscv_zvt_vtfmm_alt_tvv: {
+      bool HasFRM = false;
+      unsigned PseudoInst;
+      uint64_t TileNum = Node->getConstantOperandVal(2);
+      SDValue Op1 = Node->getOperand(3);
+      SDValue Op2 = Node->getOperand(4);
+      SDValue Chain = Node->getOperand(0);
