+//===----------------------------------------------------------------------===//
+// Tile subset load/store to memory (LOAD-FP / STORE-FP, mew = 1, width = 111).
+// nf selects EEW: 000 -> 8, 001 -> 16, 010 -> 32, 011 -> 64.
+//===----------------------------------------------------------------------===//
+
+class ZvtTileMemOp<bits<3> nf, RISCVOpcode opcode, dag outs, dag ins,
+                   string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs2;
+  bits<5> rs1;
+
+  let Inst{31-29} = nf;
+  let Inst{28} = 1;                       // mew
+  let Inst{27-26} = MOPLDUnitStride.Value;
+  let Inst{25} = 1;                       // vm
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = 0b111;                // width
+  let Inst{11-7} = 0b00000;
+  let Inst{6-0} = opcode.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+let hasSideEffects = 0, mayLoad = 1, mayStore = 0 in
+class ZvtTileLoad<bits<3> nf, string opcodestr>
+    : ZvtTileMemOp<nf, OPC_LOAD_FP, (outs), (ins GPR:$rs2, GPRMemZeroOffset:$rs1),
+                   opcodestr, "$rs2, ${rs1}">;
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 1 in
+class ZvtTileStore<bits<3> nf, string opcodestr>
+    : ZvtTileMemOp<nf, OPC_STORE_FP, (outs), (ins GPR:$rs2, GPRMemZeroOffset:$rs1),
+                   opcodestr, "$rs2, ${rs1}">;
+
+//===----------------------------------------------------------------------===//
+// Matrix multiply C += A^T * B (OP-VE, funct6 = 111100). funct3 selects
+// integer (000) or floating-point (001); the alt bit (Inst[7]) selects the
+// alternate-datatype variant. The destination tile occupies Inst[11:8].
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtMatmul<bits<3> funct3, bit alt, string opcodestr>
+    : RVInst<(outs), (ins TR:$rd, VR:$vs2, VR:$vs1), opcodestr,
+             "$rd, $vs2, $vs1", [], InstFormatR> {
+  bits<5> vs2;
+  bits<5> vs1;
+  bits<4> rd;
+
+  let Inst{31-26} = 0b111100;
+  let Inst{25} = 1;                 // vm
+  let Inst{24-20} = vs2;
+  let Inst{19-15} = vs1;
+  let Inst{14-12} = funct3;
+  let Inst{11-8} = rd;
+  let Inst{7} = alt;
+  let Inst{6-0} = OPC_OP_VE.Value;
+
+  let Uses = [VTYPE, VL];
+}
