+def HasStdExtZvti8i32mm : Predicate<"Subtarget->hasStdExtZvti8i32mm()">,
+                          AssemblerPredicate<(all_of FeatureStdExtZvti8i32mm),
+                              "'Zvti8i32mm' (RISC-V Vector Matrix Extension Int8-Int32 Matrix Multiply)">;
+
+def FeatureStdExtZvtf8f32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension FP8-FP32 Matrix Multiply",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvtf8f32mm : Predicate<"Subtarget->hasStdExtZvtf8f32mm()">,
+                          AssemblerPredicate<(all_of FeatureStdExtZvtf8f32mm),
+                              "'Zvtf8f32mm' (RISC-V Vector Matrix Extension FP8-FP32 Matrix Multiply)">;
+
+def FeatureStdExtZvtf16f32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension FP16-FP32 Matrix Multiply",
