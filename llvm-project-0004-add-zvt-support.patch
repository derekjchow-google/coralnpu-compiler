+//===- IntrinsicsRISCVZvt.td - Zvt intrinsics ---------------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines all of the Zvt (Vector Matrix Extension) intrinsics for RISC-V.
+//
+//===----------------------------------------------------------------------===//
+
+let TargetPrefix = "riscv" in {
+
+  // Zvt Configuration Intrinsics
+  // Output: (actual_set_dim)
+  // Input: (requested_dim)
+  class ZvtMSetIntrinsic
+      : DefaultAttrsIntrinsic<[llvm_anyint_ty], [LLVMMatchType<0>],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_msettn : ZvtMSetIntrinsic;
+  def int_riscv_zvt_msettm : ZvtMSetIntrinsic;
+  def int_riscv_zvt_msettk : ZvtMSetIntrinsic;
+
+  // msetmtype: writes mtype (rs1) and vtype (rs2)
+  // Output: ()
+  // Input: (mtype, vtype)
+  def int_riscv_zvt_msetmtype
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, LLVMMatchType<0>],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Tile Load/Store
+  // Input: (tile_index_gpr, base_addr)
+  class ZvtTileLoadIntrinsic
+      : Intrinsic<[], [llvm_anyint_ty, llvm_ptr_ty],
+                  [IntrReadMem, IntrHasSideEffects], "", [], 1>;
+
+  class ZvtTileStoreIntrinsic
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_ptr_ty],
+                              [IntrWriteMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_vtle8  : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle16 : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle32 : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle64 : ZvtTileLoadIntrinsic;
+
+  def int_riscv_zvt_vtse8  : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse16 : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse32 : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse64 : ZvtTileStoreIntrinsic;
+
+  // Zvt Tile Zero/Discard
+  // vtzero takes a static tile register, so we use ImmArg.
+  // Input: (tile_num_imm)
+  def int_riscv_zvt_vtzero : DefaultAttrsIntrinsic<[], [llvm_anyint_ty],
+                                                   [ImmArg<ArgIndex<0>>, IntrNoMem, IntrHasSideEffects]>;
+  def int_riscv_zvt_vtdiscard : DefaultAttrsIntrinsic<[], [], [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Tile Moves
+  // vtmv.v.t and vtmv.t.v take tile index in a GPR.
+  // Output: (vector_out)
+  // Input: (tile_index_gpr)
+  def int_riscv_zvt_vtmv_v_t
+      : DefaultAttrsIntrinsic<[llvm_anyvector_ty], [llvm_anyint_ty],
+                              [IntrNoMem]>;
+
+  // Output: ()
+  // Input: (tile_index_gpr, vector_in)
+  def int_riscv_zvt_vtmv_t_v
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_anyvector_ty],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Matrix Multiply Intrinsics
+  // Matmul takes a static tile register (TR class), so we use ImmArg.
+  // Output: ()
+  // Input: (tile_num_imm, vector_A, vector_B)
+  class ZvtMatMulIntrinsic
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_anyvector_ty, llvm_anyvector_ty],
+                              [ImmArg<ArgIndex<0>>, IntrNoMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_vtmmu_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtmms_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtfmm_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtfmm_alt_tvv : ZvtMatMulIntrinsic;
+
+} // TargetPrefix = "riscv"
