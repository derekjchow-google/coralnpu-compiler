diff --git a/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td b/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td
new file mode 100644
index 0000000000..d1df4bf4d7
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td
@@ -0,0 +1,384 @@
+//===-- RISCVInstrInfoZvt.td - RISC-V Vector Matrix Extension -*- tablegen -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file describes the instructions of the RISC-V Vector Matrix Extension
+// (VME), i.e. the Zvt family of extensions, as defined by the draft spec v0.3
+// (zvt-20260427). These instructions are not yet upstream; they are added here
+// so the CoralNPU toolchain can assemble VME programs without raw .insn/.word
+// directives.
+//
+// The matrix tile operand (mtd) reuses the XSfmmbase tile registers (mt0-mt15,
+// register class TR), whose assembly names already match the VME spec. The tile
+// number occupies instruction bits [11:8]; matrix-multiply instructions place an
+// "alternate format" bit at [7], matching sim/coralnpu_zvt.bin_fmt.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// Configuration instructions (OP-V major opcode, funct3 = OPCFG).
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 1, mayLoad = 0, mayStore = 0 in {
+// msetmtype rs1, rs2: write mtype = rs1 and vtype = rs2 (vl is cleared).
+class ZvtMSetMType<string opcodestr>
+    : RVInst<(outs), (ins GPR:$rs1, GPR:$rs2), opcodestr, "$rs1, $rs2", [],
+             InstFormatI> {
+  bits<5> rs1;
+  bits<5> rs2;
+
+  let Inst{31-25} = 0b1000001;
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPCFG.Value;
+  let Inst{11-7} = 0b00000;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Defs = [VTYPE, VL];
+}
+
+// msettn/msettm/msettk rd, rs1: set tn/tm/tk, returning the value in rd.
+class ZvtMSetSingle<bits<5> rs2val, string opcodestr>
+    : RVInst<(outs GPR:$rd), (ins GPR:$rs1), opcodestr, "$rd, $rs1", [],
+             InstFormatI> {
+  bits<5> rs1;
+  bits<5> rd;
+
+  let Inst{31-25} = 0b1000010;
+  let Inst{24-20} = rs2val;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPCFG.Value;
+  let Inst{11-7} = rd;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Defs = [VTYPE, VL];
+}
+} // hasSideEffects = 1
+
+//===----------------------------------------------------------------------===//
+// Tile <-> vector-register moves and tile zero/discard (OP-V, funct3 = OPMVX).
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtTileMove<bits<6> funct6, dag outs, dag ins, string opcodestr,
+                  string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs2;
+  bits<5> rs1;
+  bits<5> vd;
+
+  let Inst{31-26} = funct6;
+  let Inst{25} = 1;
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPMVX.Value;
+  let Inst{11-7} = vd;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtTileZero<string opcodestr>
+    : RVInst<(outs), (ins TR:$rd), opcodestr, "$rd", [], InstFormatR> {
+  bits<4> rd;
+
+  let Inst{31-26} = 0b010000;
+  let Inst{25} = 1;
+  let Inst{24-20} = 0b11110;
+  let Inst{19-15} = 0b00000;
+  let Inst{14-12} = OPMVX.Value;
+  let Inst{11-8} = rd;
+  let Inst{7} = 0;
+  let Inst{6-0} = OPC_OP_V.Value;
